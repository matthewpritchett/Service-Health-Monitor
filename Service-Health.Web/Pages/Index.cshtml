@page
@model Service_Health.Web.Pages.Index

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Service Monitor</title>

    <style>
        :root {
            color-scheme: light dark;
            --accent-gray: #E7E7E7;
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                --accent-gray: #333333;
            }
        }

        body {
            font-family: segoe ui, Roboto, Oxygen-Sans, Ubuntu, Cantarell, helvetica neue, Verdana, sans-serif;
        }

        h1 {
            margin-top: 30px;
        }

        ul {
            padding: 0;
        }

        li {
            list-style: none;
            margin-bottom: 2px;
            padding: 5px;
            border-bottom: 1px solid var(--accent-gray);
        }

        .container {
            max-width: 600px;
            width: 100%;
            margin: 15px auto;
        }

        .panel {
            text-align: center;
            padding: 10px;
            border-radius: 5px;
        }

        .group {
            background-color: var(--accent-gray);
            margin: 30px 0 10px;
        }

        .small {
            font-size: 80%;
        }

        .failed {
            color: #E25D6A;
        }

        .success {
            color: #52B86A;
        }

        .status {
            float: right;
        }

        .failed-bg {
            color: white;
            background-color: #E25D6A;
        }

        .success-bg {
            color: white;
            background-color: #52B86A;
        }

        .info {
            color: gray;
        }

        .info a {
            color: inherit;
            text-decoration: none;
            padding-top: 10px;
        }

        .info a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>
<div class="container">
    <h1>Global Status</h1>

    <ul>
        <li class="panel failed-bg">
            1 Outage(s)
        </li>
    </ul>

    <h1>Services</h1>

    <ul>
        <li>
            Google
            <span class="status success">
                    Operational
                </span>
        </li>

        <li>
            Bing
            <span class="small failed">
                    (Could not resolve host: bing.com (Domain name not found))
                </span>

            <span class="status failed">
                    Disrupted
                </span>
        </li>
    </ul>

    <p class="small info">
        Last check: 2026-08-05T13:26:44+0000
    </p>

    <h1>Incidents</h1>

    <p>
        No incident reported yet
    </p>
</div>
</body>
</html>