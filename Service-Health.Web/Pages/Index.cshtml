@page
@model Service_Health.Web.Pages.Index

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Service Health</title>

    <link rel="stylesheet" href="~/_content/Service-Health.Web/css/site.css" />
</head>
<body>
<script>
    setTimeout(() => {
        window.location.reload();
    }, @Model.RefreshInterval.TotalMilliseconds);
</script>
<div class="container">

    <h1>Global Status</h1>

    @if (Model.Results.Any(x => !x.Success))
    {
        <ul>
            <li class="panel failed-bg">
                @Model.Results.Count(x => !x.Success) Outage(s)
            </li>
        </ul>
    }
    else
    {
        <ul>
            <li class="panel success-bg">
                All Systems Operational
            </li>
        </ul>
    }

    <h1>Services</h1>

    <ul>
        @foreach (var group in Model.Results.GroupBy(x => x.GroupName))
        {
            <li class="panel group">
                @group.Key
            </li>

            foreach (var service in group)
            {
                <li>
                    <a class="service-link" href="/ServiceHistory?key=@service.Key">
                        @service.ServiceName
                    </a>

                    @if (!string.IsNullOrWhiteSpace(service.Message))
                    {
                        <span class="small">
                            (@service.Message)
                        </span>
                    }

                    @if (service.Success)
                    {
                        <span class="status success">
                            Operational
                        </span>
                    }
                    else
                    {
                        <span class="status failed">
                            Disrupted
                        </span>
                    }
                </li>
            }
        }
    </ul>

    <p class="small info">
        Last check:
        @(Model.Results.MaxBy(x => x.Timestamp)?.Timestamp.UtcDateTime.ToString("MMM dd, yyyy hh:mm:ss tt")) UTC
    </p>

    <h1>Incidents</h1>

    <p>No incident reported yet</p>

    <p class="small info">
        Generated by Service-Health
    </p>

</div>

</body>
</html>