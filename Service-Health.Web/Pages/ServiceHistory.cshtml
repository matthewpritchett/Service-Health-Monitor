@page
@model Service_Health.Web.Pages.ServiceHistory

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Service History</title>

    <link rel="stylesheet" href="~/_content/Service-Health.Web/css/site.css" />
</head>
<body>
<script>
    setTimeout(() => {
        window.location.reload();
    }, @Model.RefreshInterval.TotalMilliseconds);
</script>
<div class="container">

    <h1>Service History</h1>

    <ul>
        @if (!Model.Results.Any())
        {
            <li class="panel">
                No history found
            </li>
        }
        else
        {
            foreach (var result in Model.Results)
            {
                <li>
                    @result.Timestamp.UtcDateTime.ToString("MMM dd, yyyy hh:mm:ss tt") UTC

                    @if (!string.IsNullOrWhiteSpace(result.Message))
                    {
                        <span class="small info">
                            (@result.Message)
                        </span>
                    }

                    @if (result.Success)
                    {
                        <span class="status success">
                            Operational
                        </span>
                    }
                    else
                    {
                        <span class="status failed">
                            Disrupted
                        </span>
                    }
                </li>
            }
        }
    </ul>

    <p class="small info">
        <a href="/">
            Back to services
        </a>
    </p>

</div>

</body>
</html>